[Unit]
Description=Reality residential subscription leaf service
After=network-online.target
Wants=network-online.target
# Never give up restarting; a bad EnvironmentFile now exits 2 with a
# named variable in the journal instead of a bare traceback.
StartLimitIntervalSec=0

[Service]
Type=simple
# Runs unprivileged. systemd reads EnvironmentFile as root before dropping
# privileges, so secrets.env stays 0600 root-only and is unreachable from
# the HTTP server itself; CAP_NET_BIND_SERVICE is all that is needed for :80.
User=anyreality-sub
Group=anyreality-sub
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
EnvironmentFile=/etc/anyreality-resi-stack/subscription-leaf.env
ExecStart=/usr/bin/python3 /usr/local/lib/anyreality-resi-stack/leaf_server.py
Restart=always
RestartSec=3
WorkingDirectory=/usr/local/lib/anyreality-resi-stack
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/anyreality-resi-stack
ProtectKernelTunables=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
